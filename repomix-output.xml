      <div id="error-duplicado" class="mensaje mensaje--error" role="alert" hidden>
        <strong>Este registro ya existe, verifica la información.</strong>
        <p>Campo en conflicto: <span id="campo-conflicto">Nombre de la universidad</span></p>
      </div>

      <section id="tarjeta-formulario" class="tarjeta">
