          </div>

          <div class="fila-doble">
            <div class="campo">
              <label for="departamento">Departamento <span class="obligatorio" aria-hidden="true">*</span></label>
              <select id="departamento" name="departamento" required>
                <option value="" selected>Selecciona un departamento</option>
                <option>Ahuachapán</option>
                <option>Cabañas</option>
                <option>Chalatenango</option>
                <option>Cuscatlán</option>
                <option>La Libertad</option>
                <option>La Paz</option>
                <option>La Unión</option>
                <option>Morazán</option>
                <option>San Miguel</option>
                <option>San Salvador</option>
                <option>San Vicente</option>
                <option>Santa Ana</option>
                <option>Sonsonate</option>
                <option>Usulután</option>
              </select>
              <p class="campo__error">Selecciona el departamento.</p>
            </div>

            <div class="campo">
              <label for="direccion">Dirección <span class="obligatorio" aria-hidden="true">*</span></label>
              <input
                type="text" id="direccion" name="direccion"
                required minlength="5" maxlength="200"
                autocomplete="street-address"
                placeholder="Municipio, colonia, calle"
              />
              <p class="campo__error">Ingresa la dirección (mínimo 5 caracteres).</p>
            </div>
          </div>

          <!--Contacto-->
