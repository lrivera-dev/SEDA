}

/* ---------- Mensajes globales ---------- */
.mensaje { margin-bottom: 20px; padding: 14px 18px; border: 1px solid; border-radius: var(--radio); }
.mensaje p, .mensaje ul { margin: 6px 0 0; }
.mensaje ul { padding-left: 20px; }
.mensaje--error { color: var(--color-error); background: var(--color-error-fondo); border-color: var(--color-error-borde); }

/* ---------- Confirmación ---------- */
.confirmacion { text-align: center; }
.confirmacion h2 { margin: 12px 0 6px; color: var(--color-exito); }
.confirmacion p { margin: 0 0 22px; color: var(--color-texto-suave); }
.confirmacion__icono {
  width: 64px;
  height: 64px;
  margin: 0 auto;
  display: grid;
  place-items: center;
  font-size: 2rem;
  font-weight: 700;
  color: var(--color-exito);
  background: var(--color-exito-fondo);
  border-radius: 50%;
}

/* ---------- Responsive ---------- */
@media (max-width: 560px) {
  .tarjeta { padding: 20px 16px; }
  .fila-doble { grid-template-columns: 1fr; }
  .acciones .btn { width: 100%; }
}
