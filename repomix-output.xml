}
.seccion:not(:first-child) { margin-top: 32px; }

/* ---------- Campos ---------- */
.campo { margin-bottom: 20px; }
.campo > label { display: block; margin-bottom: 6px; font-weight: 600; }
.obligatorio { color: var(--color-error); }

.fila-doble { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18px; }

.campo input[type="text"],
.campo input[type="email"],
.campo input[type="tel"],
.campo input[type="password"],
.campo select {
  width: 100%;
  padding: 10px 12px;
  font: inherit;
  color: var(--color-texto);
  background: var(--color-superficie-suave);
  border: 1px solid var(--color-borde);
  border-radius: 8px;
  transition: border-color .15s, box-shadow .15s;
}
.campo input::placeholder { color: var(--color-texto-suave); }

.campo input:focus,
.campo select:focus {
  outline: none;
  border-color: var(--color-borde-foco);
  box-shadow: 0 0 0 3px var(--color-anillo-foco);
}

.campo input:disabled { background: #e3e8f0; color: var(--color-texto-suave); cursor: not-allowed; }

.campo__ayuda { margin: 6px 0 0; font-size: .85rem; color: var(--color-texto-suave); }

.check { display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 400; }
.check input { width: 18px; height: 18px; accent-color: var(--color-primario); cursor: pointer; }
.check--mini { margin-top: 8px; font-size: .9rem; }

/* ---------- Validación visual por campo ----------*/
.campo__error {
  display: none;
  margin: 6px 0 0;
  font-size: .85rem;
  font-weight: 600;
  color: var(--color-error);
}
.campo:has(:user-invalid) .campo__error,
.campo.campo--invalido .campo__error { display: block; }

.campo:has(:user-invalid) .campo__ayuda,
.campo.campo--invalido .campo__ayuda { display: none; }

.campo input:user-invalid,
.campo select:user-invalid,
.campo.campo--invalido input,
.campo.campo--invalido select {
  border-color: var(--color-error);
  background: var(--color-error-fondo);
}
.campo input:user-invalid:focus,
.campo select:user-invalid:focus,
.campo.campo--invalido input:focus,
.campo.campo--invalido select:focus { box-shadow: 0 0 0 3px var(--color-anillo-error); }

.campo input:user-valid,
.campo select:user-valid { border-color: var(--color-exito); }

/* ---------- Botones ---------- */
.acciones { margin-top: 28px; }

.btn {
  display: inline-block;
  padding: 12px 28px;
  font: inherit;
  font-weight: 600;
  text-decoration: none;
  color: var(--color-texto-sobre-primario);
  background: var(--color-primario);
  border: 1px solid var(--color-primario);
  border-radius: 8px;
  cursor: pointer;
  transition: background .15s;
}
.btn:hover { background: var(--color-primario-hover); border-color: var(--color-primario-hover); }
.btn:focus-visible { outline: 3px solid var(--color-anillo-foco); outline-offset: 2px; }
.btn:disabled {
  background: var(--color-deshabilitado);
  border-color: var(--color-deshabilitado);
